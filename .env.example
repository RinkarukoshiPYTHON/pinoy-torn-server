# Kopyahin ito bilang .env  —  copy this to .env on the server
# PORT na pakikinggan ng server (kailangan buksan sa firewall ng VPS)
PORT=3000
# Palitan ng mahaba at random na secret bago mag-live. HUWAG i-commit ang totoong .env.
JWT_SECRET=palitan-mo-ito-ng-mahaba-at-random-na-secret
# Saan naka-save ang data (JSON file, walang external DB)
DATA_FILE=./data.json
# Para sa web client: isang setting lang ang kailangan baguhin doon.
# Halimbawa, kapag naka-deploy ka na: API_URL=https://api.pinoytorn.ph
API_URL=http://localhost:3000
